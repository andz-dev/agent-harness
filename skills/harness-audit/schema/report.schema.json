{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/harness-audit/report.schema.json",
  "title": "harness-audit report",
  "description": "Machine-readable result of one harness-audit run on one repository. Draft 0.1, matches catalog_version 0.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "generated_at",
    "repo",
    "stack",
    "findings",
    "limitations"
  ],
  "allOf": [
    {
      "if": {
        "required": ["quality"],
        "properties": {
          "quality": {"properties": {"availability": {"const": "unavailable"}}}
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["pillars"]},
            {"required": ["score"]},
            {"required": ["entropy"]},
            {"required": ["top_gaps"]}
          ]
        }
      },
      "else": {"required": ["pillars", "score", "entropy", "top_gaps"]}
    }
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "catalog_version"
      ],
      "properties": {
        "name": {
          "const": "harness-audit"
        },
        "version": {
          "type": "string"
        },
        "catalog_version": {
          "type": "string"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "synthetic": {"type": "boolean"}
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "commit",
        "clone_mode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "owner/name or directory name"
        },
        "url": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "default_branch": {
          "type": "string"
        },
        "clone_mode": {
          "enum": [
            "shallow",
            "blobless",
            "full",
            "local"
          ],
          "description": "shallow = --depth 1; blobless = --filter=blob:none; local = audited in place."
        },
        "weight": {
          "enum": [
            "low",
            "mid",
            "high"
          ],
          "description": "From example-repos.json, when known."
        }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecosystems",
        "components"
      ],
      "properties": {
        "ecosystems": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 0,
          "items": {
            "enum": [
              "python",
              "node"
            ]
          }
        },
        "components": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "unsupported": {
          "type": "array",
          "description": "Manifests of ecosystems outside v1 scope (Go, Rust, Dart, ...), reported so they are not silently missed.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "language",
              "manifest"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "language": {
                "type": "string"
              },
              "manifest": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "pillars": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/pillar_result"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "score": {
      "$ref": "#/$defs/score"
    },
    "entropy": {
      "$ref": "#/$defs/entropy"
    },
    "top_gaps": {
      "type": "array",
      "maxItems": 5,
      "description": "Highest-value failed checks, each with one concrete fix.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "fix"
        ],
        "properties": {
          "check_id": {
            "$ref": "#/$defs/check_id"
          },
          "fix": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "description": "Anything that reduced confidence: shallow history, skipped checks, LLM layer off, unreadable files.",
      "items": {
        "type": "string"
      }
    },
    "quality": {
      "$ref": "#/$defs/quality"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "infra": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scored",
        "tools",
        "kinds",
        "detected"
      ],
      "description": "Infrastructure overlay: detected IaC, container and dev-environment files. Never part of the 0-100 score (decision D1).",
      "properties": {
        "scored": {
          "const": false
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "tool",
              "scope",
              "file_count",
              "files",
              "sample",
              "status"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              },
              "file_count": {
                "type": "integer"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sample": {
                "type": "boolean"
              },
              "status": {
                "enum": [
                  "detected-not-scored"
                ]
              },
              "component": {
                "type": "string"
              }
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "area",
              "level",
              "title",
              "scope",
              "status",
              "evidence",
              "note"
            ],
            "properties": {
              "check_id": {
                "type": "string"
              },
              "area": {
                "enum": [
                  "dockerfile",
                  "compose",
                  "devcontainer",
                  "terraform",
                  "bicep",
                  "kubernetes",
                  "ansible",
                  "cloudformation",
                  "pulumi",
                  "cross-cutting",
                  "agent-guidance",
                  "infra-entropy"
                ]
              },
              "level": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "not_applicable",
                  "unknown"
                ]
              },
              "note": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "snippet"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "snippet": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "passed",
              "failed",
              "not_applicable",
              "pass_rate"
            ],
            "properties": {
              "passed": {
                "type": "integer"
              },
              "failed": {
                "type": "integer"
              },
              "not_applicable": {
                "type": "integer"
              },
              "pass_rate": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "rollup": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "area",
              "level",
              "title",
              "passed",
              "failed",
              "not_applicable",
              "failing"
            ],
            "properties": {
              "check_id": {
                "type": "string"
              },
              "area": {
                "type": "string"
              },
              "level": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "passed": {
                "type": "integer"
              },
              "failed": {
                "type": "integer"
              },
              "not_applicable": {
                "type": "integer"
              },
              "failing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "overall",
            "weakest_area",
            "areas"
          ],
          "properties": {
            "overall": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 3
            },
            "weakest_area": {
              "type": [
                "string",
                "null"
              ]
            },
            "areas": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "level",
                  "blocked_by",
                  "pass_ratio_by_level"
                ],
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "blocked_by": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "pass_ratio_by_level": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                }
              }
            },
            "repo_wide": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pillar_name": {
      "enum": [
        "orientation",
        "verification",
        "static_guardrails",
        "automatic_triggers",
        "workflow_entry_points",
        "pipeline_parity",
        "doc_hygiene"
      ]
    },
    "check_id": {
      "type": "string",
      "pattern": "^(ORI|VER|STA|TRG|ENT|CIP|DOC|ENR)-[0-9]{2}$"
    },
    "coverage_check_id": {
      "type": "string",
      "pattern": "^(ORI|VER|STA|TRG|ENT|CIP|DOC|ENR)-[0-9]{2}$|^INF-[A-Z][0-9]{2}$"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "score", "reason_codes"],
      "properties": {
        "availability": {"enum": ["available", "partial", "unavailable"]},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "coverage_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "languages", "adapter", "applicability"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "root": {"type": "string"},
        "languages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "adapter": {"enum": ["python", "node", null]},
        "applicability": {"$ref": "#/$defs/applicability"}
      }
    },
    "applicability": {
      "enum": ["applicable", "inapplicable", "unsupported", "undetermined"]
    },
    "coverage_evidence": {
      "enum": ["declared", "static_implementation_found", "execution_observed", "prototype_simulated", "unknown"]
    },
    "freshness": {
      "enum": ["current", "stale", "unknown"]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {"enum": ["absent", "present_unverified", "invalid", "stale", "partial", "failed"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "sources", "method", "observed_at"],
      "properties": {
        "revision": {"type": "string"},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "locator"],
            "properties": {
              "path": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "locator": {"type": "string"}
            }
          }
        },
        "method": {"type": "string"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "coverage_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component_id", "topic_id", "check_ids", "applicability", "evidence", "freshness", "provenance", "receipt", "limitations"],
      "properties": {
        "id": {"type": "string"},
        "component_id": {"type": "string"},
        "topic_id": {"type": "string"},
        "check_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/coverage_check_id"}},
        "applicability": {"$ref": "#/$defs/applicability"},
        "evidence": {"$ref": "#/$defs/coverage_evidence"},
        "freshness": {"$ref": "#/$defs/freshness"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "receipt": {"$ref": "#/$defs/receipt"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "runner_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "resolution"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": ["string", "null"]},
        "resolution": {"enum": ["resolved", "unresolved", "cycle", "budget_exceeded"]}
      }
    },
    "coverage_collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "limits", "reason_codes"],
      "properties": {
        "outcome": {"enum": ["complete", "partial", "failed"]},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_file_bytes", "max_total_bytes", "max_candidate_paths", "max_runner_depth"],
          "properties": {
            "max_file_bytes": {"type": "integer", "minimum": 1},
            "max_total_bytes": {"type": "integer", "minimum": 1},
            "max_candidate_paths": {"type": "integer", "minimum": 1},
            "max_runner_depth": {"type": "integer", "minimum": 1}
          }
        },
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "components", "observations", "runner_edges", "collection", "limitations"],
      "properties": {
        "version": {"const": 1},
        "components": {"type": "array", "items": {"$ref": "#/$defs/coverage_component"}},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/coverage_observation"}},
        "runner_edges": {"type": "array", "items": {"$ref": "#/$defs/runner_edge"}},
        "collection": {"$ref": "#/$defs/coverage_collection"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "ecosystem"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "description": "Relative to the repo root; '.' for the root component."
        },
        "ecosystem": {
          "enum": [
            "python",
            "node"
          ]
        },
        "kind": {
          "enum": [
            "app",
            "library",
            "service",
            "tooling",
            "sample",
            "unknown"
          ]
        },
        "tracked_files": {
          "type": "integer",
          "minimum": 0,
          "description": "Used as the size weight when scoring mixed repos."
        },
        "detected_by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Manifest files that identified this component (pyproject.toml, package.json)."
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "snippet"
      ],
      "properties": {
        "kind": {
          "enum": [
            "found",
            "searched"
          ],
          "description": "found = something that supports the status; searched = what was looked at and not found (failed checks)."
        },
        "path": {
          "type": "string",
          "description": "File path, or the glob that was searched."
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "snippet": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "pillar",
        "level",
        "status",
        "source",
        "evidence"
      ],
      "properties": {
        "check_id": {
          "$ref": "#/$defs/check_id"
        },
        "pillar": {
          "oneOf": [
            {
              "$ref": "#/$defs/pillar_name"
            },
            {
              "const": "entropy"
            }
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "component": {
          "type": "string",
          "description": "Component id; omitted for repo-wide checks."
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_applicable",
            "unknown",
            "error"
          ],
          "description": "unknown = LLM could not decide or no evidence reachable; error = the detector itself failed."
        },
        "source": {
          "enum": [
            "script",
            "llm"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "Required for llm findings."
        },
        "gate": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "llm"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "confidence"
            ],
            "properties": {
              "evidence": {
                "items": {
                  "required": [
                    "line"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "found"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "pillar_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pillar",
        "level",
        "weight",
        "points",
        "gate_failures"
      ],
      "properties": {
        "pillar": {
          "$ref": "#/$defs/pillar_name"
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "points": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "level / 3 * weight"
        },
        "gate_failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check_id"
          },
          "description": "Gate checks that blocked a higher level."
        },
        "capped_by": {
          "type": "string",
          "enum": [
            "verification"
          ],
          "description": "Level reduced because Verification is more than one level lower."
        },
        "by_component": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "level"
            ],
            "properties": {
              "component": {
                "type": "string"
              },
              "level": {
                "$ref": "#/$defs/level"
              }
            }
          }
        },
        "weakest_component": {
          "type": "string"
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "caps_applied",
        "entropy_penalty",
        "final"
      ],
      "properties": {
        "raw": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Sum of pillar points before caps and penalty."
        },
        "caps_applied": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "limit",
              "reason"
            ],
            "properties": {
              "id": {
                "enum": [
                  "no-tests",
                  "no-ci",
                  "no-orientation"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "entropy_penalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "final": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "entropy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_files",
        "flagged_files",
        "penalty",
        "items"
      ],
      "properties": {
        "candidate_files": {
          "type": "integer",
          "minimum": 0
        },
        "flagged_files": {
          "type": "integer",
          "minimum": 0
        },
        "penalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "history_available": {
          "type": "boolean",
          "description": "False when only a shallow clone was available; history-based checks were skipped."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "path",
              "verdict",
              "evidence"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "pattern": "^ENR-[0-9]{2}$"
              },
              "path": {
                "type": "string"
              },
              "verdict": {
                "enum": [
                  "active",
                  "stale",
                  "orphaned",
                  "conflicting",
                  "unknown"
                ]
              },
              "last_commit": {
                "type": "string",
                "format": "date"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              }
            }
          }
        }
      }
    }
  }
}
